# METRIA Environment Configuration Example
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT PRIVATE KEYS OR ACTUAL PAID RPC SECRETS TO SOURCE CONTROL.

# Optional server-side RPC URL for Mainnet. Defaults to the public Mainnet RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional server-side RPC URL for Devnet. Defaults to the public Devnet RPC.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional deployed app origin used by the API documentation page.
NEXT_PUBLIC_APP_URL=http://localhost:3000
